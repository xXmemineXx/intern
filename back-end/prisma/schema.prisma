generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model permit {
  permit_id                                        Int                @id @default(autoincrement())
  submit_date                                      DateTime           @default(dbgenerated("CURRENT_DATE")) @db.Date
  permit_type                                      Int
  leave_start                                      DateTime           @db.Date
  leave_duration                                   Int
  account_id                                       String             @db.VarChar(20)
  permit_status                                    String             @default("waiting") @db.VarChar(10)
  account                                          users              @relation(fields: [account_id], references: [id_], onDelete: NoAction, onUpdate: NoAction)
  permit_type_permit_permit_typeTopermit_type      permit_type        @relation("permit_permit_typeTopermit_type", fields: [permit_type], references: [type_id], onDelete: NoAction, onUpdate: NoAction)
  permit_documents_permit_documents_permitTopermit permit_documents[] @relation("permit_documents_permitTopermit")
  review_review_permitTopermit                     review[]           @relation("review_permitTopermit")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model review {
  review_id                    Int     @id @default(autoincrement())
  permit                       Int
  reviewer                     String  @db.VarChar(20)
  motif                        String? @default("")
  status                       String  @default("waiting") @db.VarChar(15)
  permit_review_permitTopermit permit  @relation("review_permitTopermit", fields: [permit], references: [permit_id], onDelete: NoAction, onUpdate: NoAction)
  account                      users   @relation(fields: [reviewer], references: [id_], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id_              String   @id @db.VarChar(20)
  password_hash    String   @db.VarChar(255)
  name_            String   @db.VarChar(20)
  firstname_       String?  @db.VarChar(30)
  phone_           String   @db.VarChar(13)
  mail_            String?  @default("") @db.VarChar(40)
  regime_          String?  @default("civil") @db.VarChar(10)
  service          String   @db.VarChar(40)
  poste            String   @db.VarChar(20)
  decisional_power Boolean? @default(false)
  superior_id      String?  @db.VarChar(20)
  account_role     String?  @default("worker") @db.VarChar(20)
  account_status   String?  @default("pending") @db.VarChar(15)
  balance          Json?
  permit           permit[]
  review           review[]
  users            users?   @relation("usersTousers", fields: [superior_id], references: [id_], onDelete: NoAction, onUpdate: NoAction)
  other_users      users[]  @relation("usersTousers")
}

model permit_documents {
  document_id                            Int     @id @default(autoincrement())
  permit                                 Int
  document_name                          String? @default("") @db.VarChar(50)
  storage_path                           String  @db.VarChar(200)
  permit_permit_documents_permitTopermit permit  @relation("permit_documents_permitTopermit", fields: [permit], references: [permit_id], onDelete: NoAction, onUpdate: NoAction)
}

model permit_type {
  type_id                                Int      @id @default(autoincrement())
  type_name                              String   @unique @db.VarChar(20)
  min_day                                Int
  max_day                                Int?
  permit_permit_permit_typeTopermit_type permit[] @relation("permit_permit_typeTopermit_type")
}
